DATABASE_URL=postgresql://mgd_user:mgd_password@localhost:5432/gestionmgd

# Obligatoria: clave de firma JWT (única variable de secreto de la app).
# No existe valor por defecto: sin ella cada arranque genera una clave
# efímera y los tokens caducan al reiniciar.
#   generar: openssl rand -hex 32
JWT_SECRET_KEY=cambia_esto_por_una_clave_aleatoria_de_32_bytes_hex

# Sincronización con servidor central (opcional, solo en instalaciones que
# vayan a sincronizar — ver deploy/README.md). Dejar sin definir en el
# servidor mismo: no necesita sincronizarse consigo mismo.
# SYNC_SERVER_URL=https://kriteriovault.naslive.es
# SYNC_API_KEY=
